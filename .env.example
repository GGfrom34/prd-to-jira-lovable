# Copy to .env (gitignored) and fill in YOUR values, then run:
#   npx supabase secrets set --env-file .env
# Do not paste these values into chat, Lovable, or any file that is committed.

ANTHROPIC_API_KEY=
# 16+ random characters, e.g. from a password manager
VISITOR_SALT=
# Exact origins, comma-separated, no trailing slash
ALLOWED_ORIGINS=https://id-preview--d9d9f794-481f-45b3-a38d-b1522c1b08a5.lovable.app
# From the Apps Script deployment, and the SHARED_SECRET you set in its script properties
SHEET_WEBHOOK_URL=
SHEET_SHARED_SECRET=

# Deliberately low while testing; raise later
GLOBAL_DAILY_TOKEN_CAP=100000
VISITOR_DAILY_TOKEN_CAP=60000
SESSION_TOKEN_CAP=60000
